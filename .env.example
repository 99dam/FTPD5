# ---------------------------------------------------------------
# FTPD5 – Frontend environment variables
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local)
#
# สำคัญ: ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูกรวมเข้าไปใน JavaScript ที่ส่งให้ Browser
# จึง "ไม่ใช่ความลับ" ใส่ได้เฉพาะค่าที่เปิดเผยได้เท่านั้น
# ห้ามใส่ Service Role Key / Secret Key ในไฟล์นี้หรือใน GitHub เด็ดขาด
# ---------------------------------------------------------------

# Supabase Project URL (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Publishable key (sb_publishable_...) หรือ legacy anon key
# ปลอดภัยเมื่อเปิด RLS ครบทุกตารางตาม supabase/migrations
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ต้องตรงกับชื่อ GitHub Repository (มี / ปิดหัวท้าย)
VITE_BASE_PATH=/FTPD5/

# ออกจากระบบอัตโนมัติเมื่อไม่มีการใช้งาน (นาที)
VITE_IDLE_TIMEOUT_MINUTES=30
